{
  "name": "safeguard-backend-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "start": "npm run serve",
    "deploy": "firebase deploy --only functions,firestore",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "firebase-tools": "^15.20.0",
    "typescript": "^5.7.2"
  }
}
